# Ambientes
.venv/
venv/
env/
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/

# Testes / cache
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Resultados pesados (versionar so o codigo). Nao ha pasta de dados: os tres
# datasets sao sinteticos e nascem de uma semente, em memoria.
results/**
!results/**/
!results/**/.gitkeep
# Saídas do treino interativo do notebook: nunca são resultado oficial.
results/notebook/

# Texto do TCC (PDFs pesados) e documentos de processo: servem para PRODUZIR o
# trabalho, nao para quem clona e quer rodar. Ficam so na maquina do autor.
docs/*
!docs/.gitkeep

# Sistema / editor
.DS_Store
Thumbs.db
.vscode/*
!.vscode/settings.json

# Segredos
.env
*.key
