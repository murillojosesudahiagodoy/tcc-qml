# Ambientes
.venv/
venv/
env/
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/

# Testes / cache
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Resultados: versionam-se as quatro pastas oficiais (metrics, tables, figures,
# weights), para que tabelas e figuras do texto possam ser conferidas sem rodar
# nada. Nao ha pasta de dados: os tres datasets sao sinteticos e nascem de uma
# semente, em memoria.
results/*
!results/metrics/
!results/tables/
!results/figures/
!results/weights/
# Sobras dos notebooks antigos, que nenhum subcomando grava.
results/figures/notebook/
# Saídas do treino interativo do notebook: nunca são resultado oficial.
results/notebook/

# Texto do TCC (PDFs pesados) e documentos de processo: servem para PRODUZIR o
# trabalho, nao para quem clona e quer rodar. Ficam so na maquina do autor.
docs/*
!docs/.gitkeep

# Sistema / editor
.DS_Store
Thumbs.db
.vscode/*
!.vscode/settings.json

# Segredos
.env
*.key
